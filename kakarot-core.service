[Unit]
Description=Kakarot core daemon
Documentation=man:kakarot-daemon(1)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@PYTHON@ -m kakarot_daemon.daemon
WorkingDirectory=@PREFIX@
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
MemoryHigh=128M
MemoryMax=192M
Environment="PATH=@PREFIX@/venv/bin:%h/.local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=@PREFIX@"
Environment="PYTHONUNBUFFERED=1"
Environment="XDG_CONFIG_HOME=%h/.config"
Environment="XDG_DATA_HOME=%h/.local/share"
Environment="XDG_RUNTIME_DIR=/run/user/%U"

[Install]
WantedBy=graphical-session.target
Alias=kakarot.service
